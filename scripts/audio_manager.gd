
extends Node
## Autoload that manages the game's music, engine audio and sound effects.
## Music and sound effects can be generated procedurally or replaced
## with external audio files through the corresponding override settings.

const SR := 44100
const BPM := 148.0
const STEP := 60.0 / BPM / 4.0

## External music files (optional). An empty path uses the procedural
## soundtrack generated by the corresponding build function.
var music_override := "res://Music/Vitalezzz_Trace-Agent_loop.mp3"   
var menu_music_override := "res://Music/Umplix_A-block-in-space.ogg" 
## Optional external replacements for procedural sound effects.
## Each key corresponds to an effect in _build_sfx(); an empty path
## retains the procedurally generated sound.
var sfx_overrides := {
	"coin": "",        # coin pickup
	"power": "",       # powerup pickup
	"superready": "",  # SUPER SHOT charge-complete ping
	"shoot": "res://sfx/alienshoot3.ogg",  # blaster shot
	"supershot": "", # SUPER SHOT shockwave launch
	"explode": "",   # traffic explosion
	"crash": "",     # player crash / collision boom
	"buy": "",       # garage purchase
	"hit": "",       # hull damage / life lost
}
var music_player: AudioStreamPlayer
var menu_player: AudioStreamPlayer  # ambient menu theme
## Active music crossfade. A new fade cancels the previous one so
## its completion callback cannot stop a player that has become
## the new target after the fade direction was reversed.
var music_fade: Tween
var engine_saw: AudioStreamPlayer    # hover hum (A-minor tuned)
var engine_sub: AudioStreamPlayer    # octave+fifth partner
var engine_noise: AudioStreamPlayer  # rushing-air texture
var sfx := {}                        # Sound-effect players indexed by effect name.
var shifting_until := 0.0
var shift_timer := 0.0

## Base player volumes and user-selected volume settings.
## Individual player volumes are derived from these values.
var music_base_volume_db := -8.0
var engine_base_volumes := {}
var sfx_base_volumes := {}
var music_volume_percent := 100
var sfx_volume_percent := 100
var engine_enabled := false  # Whether the engine hum is enabled in the options.

func _ready() -> void:
	_build_music()
	_build_menu_theme()
	_build_engine()
	_build_sfx()
	set_process(true)

## Enables looping for externally loaded music streams.
## Imported audio streams do not necessarily have looping enabled,
## so configure their loop settings explicitly.
func _enable_music_loop(stream: AudioStream) -> void:
	if stream is AudioStreamMP3:
		(stream as AudioStreamMP3).loop = true
	elif stream is AudioStreamOggVorbis:
		(stream as AudioStreamOggVorbis).loop = true
	elif stream is AudioStreamWAV:
		var wav := stream as AudioStreamWAV
		# loop_end is in FRAMES: 4 bytes per stereo 16-bit frame.
		wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
		wav.loop_begin = 0
		wav.loop_end = int(wav.data.size() / 4.0)


# ---------- procedural audio synthesis helpers ----------
func _buf(frames: int) -> PackedFloat32Array:
	var b := PackedFloat32Array()
	b.resize(frames * 2)
	return b


func _kick(buf: PackedFloat32Array, start: int) -> void:
	var t := 0.0
	var i := start
	while t < 0.16 and i < int(buf.size() / 2):
		var f := 150.0 * pow(42.0 / 150.0, t / 0.11)
		var v := 0.9 * pow(0.001 / 0.9, t / 0.16) * sin(TAU * f * t)
		buf[i * 2] += v
		buf[i * 2 + 1] += v
		t += 1.0 / SR
		i += 1


func _snare(buf: PackedFloat32Array, start: int, vol: float) -> void:
	var t := 0.0
	var i := start
	while t < 0.14 and i < int(buf.size() / 2):
		var v := (randf() * 2.0 - 1.0) * vol * pow(0.001 / vol, t / 0.14) * 0.5
		buf[i * 2] += v
		buf[i * 2 + 1] += v
		t += 1.0 / SR
		i += 1


func _hat(buf: PackedFloat32Array, start: int, open: bool) -> void:
	var dur := 0.11 if open else 0.035
	var t := 0.0
	var i := start
	while t < dur and i < int(buf.size() / 2):
		var v := (randf() * 2.0 - 1.0) * 0.16 * pow(0.001 / 0.16, t / dur)
		buf[i * 2] += v
		buf[i * 2 + 1] += v
		t += 1.0 / SR
		i += 1


func _saw(buf: PackedFloat32Array, start: int, freq: float, dur: float, vol: float) -> void:
	var t := 0.0
	var i := start
	var ph := 0.0
	while t < dur and i < int(buf.size() / 2):
		ph = fmod(ph + freq / SR, 1.0)
		var v := (ph * 2.0 - 1.0) * vol * (1.0 - t / dur)
		buf[i * 2] += v
		buf[i * 2 + 1] += v
		t += 1.0 / SR
		i += 1


func _square(buf: PackedFloat32Array, start: int, freq: float, dur: float, vol: float, vib := 0.0) -> void:
	var t := 0.0
	var i := start
	while t < dur and i < int(buf.size() / 2):
		var f := freq + sin(TAU * 5.5 * t) * vib
		var v := (1.0 if fmod(t * f, 1.0) < 0.5 else -1.0) * vol * (1.0 - t / dur)
		buf[i * 2] += v
		buf[i * 2 + 1] += v
		t += 1.0 / SR
		i += 1


## Generates a frequency sweep with an exponential decay envelope.
## Can produce either a sine or sawtooth waveform.
func _sweep(
		buf: PackedFloat32Array,
		start: int,
		f0: float,
		f1: float,
		dur: float,
		vol: float,
		saw := false
) -> void:
	var t := 0.0
	var i := start
	var ph := 0.0
	while t < dur and i < int(buf.size() / 2):
		# Fast early drop, long tail: pow curve on the sweep.
		var f := lerpf(f0, f1, pow(t / dur, 0.55))
		ph = fmod(ph + f / SR, 1.0)
		var v: float = (ph * 2.0 - 1.0) if saw else sin(TAU * ph)
		v *= vol * pow(0.008, t / dur)
		buf[i * 2] += v
		buf[i * 2 + 1] += v
		t += 1.0 / SR
		i += 1


## Generates decaying noise.
## The dark option smooths successive samples to produce a lower,
## less hiss-like sound.
func _wash(
		buf: PackedFloat32Array,
		start: int,
		dur: float,
		vol: float,
		dark := false
) -> void:
	var t := 0.0
	var i := start
	var last := 0.0
	while t < dur and i < int(buf.size() / 2):
		var n: float = randf() * 2.0 - 1.0
		if dark:
			last = lerpf(last, n, 0.22)
			n = last
		var v: float = n * vol * pow(0.002, t / dur)
		buf[i * 2] += v
		buf[i * 2 + 1] += v
		t += 1.0 / SR
		i += 1


func _sub_drop(buf: PackedFloat32Array, start: int) -> void:
	var t := 0.0
	var i := start
	while t < 1.15 and i < int(buf.size() / 2):
		var f := 58.0 * pow(26.0 / 58.0, t / 0.9)
		var v := 0.8 * pow(0.001 / 0.8, t / 1.15) * sin(TAU * f * t)
		buf[i * 2] += v
		buf[i * 2 + 1] += v
		t += 1.0 / SR
		i += 1


## Converts an interleaved stereo float buffer into a 16-bit WAV stream.
## Optionally configures the resulting stream to loop.
func _to_wav(buf: PackedFloat32Array, loop: bool) -> AudioStreamWAV:
	var frames := int(buf.size() / 2)
	var bytes := PackedByteArray()
	bytes.resize(frames * 4)
	for i in frames:
		bytes.encode_s16(i * 4, int(clamp(buf[i * 2], -1.0, 1.0) * 32767.0))
		bytes.encode_s16(i * 4 + 2, int(clamp(buf[i * 2 + 1], -1.0, 1.0) * 32767.0))
	var wav := AudioStreamWAV.new()
	wav.format = AudioStreamWAV.FORMAT_16_BITS
	wav.mix_rate = SR
	wav.stereo = true
	wav.data = bytes
	if loop:
		wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
		wav.loop_begin = 0
		wav.loop_end = frames
	return wav

# ---------- music ----------
## Builds the race soundtrack.
## Uses an external music file when configured; otherwise renders
## a four-part breakbeat loop into a WAV stream.
func _build_music() -> void:
	music_player = AudioStreamPlayer.new()
	music_player.volume_db = music_base_volume_db
	add_child(music_player)
	if music_override != "":
		music_player.stream = load(music_override)
		_enable_music_loop(music_player.stream)
		return
	# render the full 4-loop cycle (8 bars ≈ 6.5 s)
	var loop_frames := int(STEP * SR * 32.0)
	var buf := _buf(loop_frames * 4)
	const KICKS := [0, 6, 10, 16, 22, 26]
	const SNARES := [4, 12, 20, 28]
	const STABS := [[6, 220.0], [14, 196.0], [22, 261.6], [30, 246.9]]
	const BASSLINE := [
		[2, 55.0, 2], [3, 55.0, 1], [8, 65.41, 2], [11, 49.0, 2],
		[18, 55.0, 2], [19, 55.0, 1], [24, 73.42, 2], [27, 49.0, 3],
		[30, 65.41, 2],
	]
	const COUNTER := [
		[4, 220.0, 3], [7, 261.63, 2], [12, 196.0, 3], [15, 220.0, 2],
		[20, 329.63, 3], [23, 261.63, 2], [28, 246.94, 3],
	]
	for loop_i in 4:
		var base := loop_i * loop_frames
		for s in KICKS: _kick(buf, base + int(s * STEP * SR))
		for s in SNARES: _snare(buf, base + int(s * STEP * SR), 1.0)
		_snare(buf, base + int(18 * STEP * SR), 0.5)
		for s in 30:
			if s % 2 == 0: _hat(buf, base + int(s * STEP * SR), false)
		_hat(buf, base + int(14 * STEP * SR), true)
		_hat(buf, base + int(30 * STEP * SR), true)
		for n in BASSLINE:
			var st: int = n[0]
			_saw(buf, base + int(st * STEP * SR), n[1], (n[2] as int) * STEP, 0.42)
		if loop_i == 1:
			for n in STABS:
				_saw(buf, base + int((n[0] as int) * STEP * SR), n[1] - 1.0, STEP * 3.0, 0.18)
				_saw(buf, base + int((n[0] as int) * STEP * SR), n[1] + 1.0, STEP * 3.0, 0.18)
		if loop_i == 3:
			for n in COUNTER:
				_square(buf, base + int((n[0] as int) * STEP * SR), n[1], (n[2] as int) * STEP, 0.09, 3.0)
			_sub_drop(buf, base)
			_sub_drop(buf, base + int(16 * STEP * SR))
	music_player.stream = _to_wav(buf, true)

## Builds the ambient menu soundtrack.
## Uses an external music file when configured; otherwise renders
## a slow four-section pad and bell arrangement without drums.
## It shares the race theme's key so both tracks crossfade naturally.
func _build_menu_theme() -> void:
	menu_player = AudioStreamPlayer.new()
	menu_player.volume_db = music_base_volume_db
	add_child(menu_player)
	# Use the external menu theme when configured.
	if menu_music_override != "":
		menu_player.stream = load(menu_music_override)
		_enable_music_loop(menu_player.stream)
		return
	# 4 sections x 2 bars (32 sixteenth steps each) ≈ 12.9 s loop
	var loop_frames := int(STEP * SR * 32.0)
	var buf := _buf(loop_frames * 4)
	const ROOTS := [110.0, 87.31, 65.41, 98.0]
	const CHORDS := [
		[220.0, 261.63, 329.63],   # Am
		[174.61, 220.0, 261.63],   # F
		[261.63, 329.63, 392.0],   # C
		[246.94, 293.66, 392.0],   # G
	]
	for section in 4:
		var base := section * loop_frames
		var section_len := float(loop_frames) / SR
		# detuned saw pad pair per chord tone — the two voices
		# beat gently against each other, the linear decay of
		# _saw gives each chord a slow swell-and-fade
		for f in CHORDS[section]:
			_saw(buf, base, (f as float) - 1.7, section_len, 0.075)
			_saw(buf, base, (f as float) + 1.7, section_len, 0.075)
		# sub root under the pad
		_saw(buf, base, (ROOTS[section] as float) * 0.5, section_len, 0.22)
		# soft sine bells (long exponential tails) over the pad,
		# one per bar
		_sweep(buf, base + int(8.0 * STEP * SR),
			(CHORDS[section][2] as float) * 2.0,
			(CHORDS[section][2] as float) * 2.0, 2.2, 0.05)
		_sweep(buf, base + int(20.0 * STEP * SR),
			(CHORDS[section][1] as float) * 2.0,
			(CHORDS[section][1] as float) * 2.0, 2.2, 0.05)
		# a breath of dark noise at each section seam
		_wash(buf, base, 1.6, 0.05, true)
	menu_player.stream = _to_wav(buf, true)

# ---------- engine ----------
## Builds the looping engine hum from three audio layers:
## a sawtooth oscillator, a lower-frequency square wave and noise.
## Their playback frequencies are adjusted together by set_engine_speed().
func _build_engine() -> void:
	var saw := _buf(SR)   # 55 Hz saw, 55 cycles in 1 s
	_saw(saw, 0, 55.0, 1.0, 1.0)
	var sq := _buf(SR)    # 25 Hz square (sub partner uses pitch_scale)
	_square(sq, 0, 25.0, 1.0, 1.0)
	var nz := _buf(SR * 2)
	for i in nz.size():
		nz[i] = randf() * 2.0 - 1.0
	engine_saw = AudioStreamPlayer.new()
	engine_saw.stream = _to_wav(saw, true)
	engine_sub = AudioStreamPlayer.new()
	engine_sub.stream = _to_wav(sq, true)
	engine_noise = AudioStreamPlayer.new()
	engine_noise.stream = _to_wav(nz, true)
	add_child(engine_saw)
	add_child(engine_sub)
	add_child(engine_noise)
	engine_base_volumes = {
		"saw": -46.0,
		"sub": -42.0,
		"noise": -50.0
	}
	# Apply the default engine levels before the options are initialized.
	engine_saw.volume_db = float(engine_base_volumes.saw)
	engine_sub.volume_db = float(engine_base_volumes.sub)
	engine_noise.volume_db = float(engine_base_volumes.noise)

# ---------- sfx ----------
## Builds the procedural sound effects and applies optional external
## replacements after all fallback streams have been created.
func _build_sfx() -> void:
	for name_s in ["coin", "power", "superready", "shoot", "supershot", "explode", "crash", "buy", "hit"]:
		var p := AudioStreamPlayer.new()
		add_child(p)
		sfx[name_s] = p
	var b := _buf(int(SR * 0.3))
	_square(b, 0, 1046.0, 0.09, 0.3)
	_square(b, int(0.09 * SR), 1568.0, 0.12, 0.25)
	sfx.coin.stream = _to_wav(b, false)
	sfx.coin.volume_db = -12.0
	b = _buf(int(SR * 0.4))
	_square(b, 0, 523.0, 0.1, 0.3)
	_square(b, int(0.1 * SR), 784.0, 0.1, 0.3)
	_square(b, int(0.2 * SR), 1046.0, 0.18, 0.3)
	sfx.power.stream = _to_wav(b, false)
	# Distinct rising two-note chime indicating that SUPER SHOT is ready.
	b = _buf(int(SR * 0.5))
	_sweep(b, 0, 880.0, 880.0, 0.35, 0.35)
	_sweep(b, int(0.09 * SR), 1318.5, 1318.5, 0.4, 0.3)
	_sweep(b, int(0.09 * SR), 2637.0, 2637.0, 0.4, 0.06)
	sfx.superready.stream = _to_wav(b, false)
	sfx.superready.volume_db = -10.0
	b = _buf(int(SR * 0.12))
	# Short falling-pitch shot with a bright attack and noise transient.
	b = _buf(int(SR * 0.22))
	_sweep(b, 0, 420.0, 70.0, 0.2, 0.35, true)
	_sweep(b, 0, 840.0, 140.0, 0.12, 0.12, true)
	_wash(b, 0, 0.04, 0.25)
	sfx.shoot.stream = _to_wav(b, false)
	# Longer, wobbling pitch sweep distinguishes the SUPER SHOT launch
	# from the shorter blaster sound.
	var wobble_buf := _buf(int(SR * 0.5))
	var wobble_ph := 0.0
	for sample_i in range(int(SR * 0.5)):
		var sample_t := float(sample_i) / SR
		var wobble_f: float = lerpf(180.0, 720.0, pow(sample_t / 0.5, 0.6)) * (
			1.0 + 0.18 * sin(TAU * 14.0 * sample_t)
		)
		wobble_ph = fmod(wobble_ph + wobble_f / SR, 1.0)
		var wobble_v: float = (
			sin(TAU * wobble_ph) * 0.5 * pow(0.01, sample_t / 0.5)
		)
		wobble_buf[sample_i * 2] += wobble_v
		wobble_buf[sample_i * 2 + 1] += wobble_v
	sfx.supershot.stream = _to_wav(wobble_buf, false)
	# Layered explosion with a low-frequency impact and decaying rumble.
	b = _buf(int(SR * 0.55))
	_sweep(b, 0, 130.0, 26.0, 0.45, 0.9)
	_wash(b, 0, 0.4, 0.7, true)
	_sweep(b, 0, 95.0, 38.0, 0.3, 0.3, true)
	sfx.explode.stream = _to_wav(b, false)
	sfx.explode.volume_db = -12.0
	# Deeper and longer version of the traffic explosion.
	b = _buf(int(SR * 0.55))
	_sweep(b, 0, 150.0, 30.0, 0.5, 1.0)
	_wash(b, 0, 0.45, 0.9, true)
	_sweep(b, 0, 110.0, 34.0, 0.35, 0.3, true)
	sfx.crash.stream = _to_wav(b, false)
	b = _buf(int(SR * 0.25))
	_square(b, 0, 659.0, 0.08, 0.25)
	_square(b, int(0.09 * SR), 880.0, 0.14, 0.25)
	sfx.buy.stream = _to_wav(b, false)
	b = _buf(int(SR * 0.3))
	_square(b, 0, 180.0, 0.06, 0.2)
	sfx.hit.stream = _to_wav(b, false)
	# Replace procedural effects with external files where configured.
	for name_s in sfx_overrides:
		var path := str(sfx_overrides[name_s])
		if path != "" and sfx.has(name_s):
			(sfx[name_s] as AudioStreamPlayer).stream = load(path)
	for name_s in sfx:
		sfx_base_volumes[name_s] = (sfx[name_s] as AudioStreamPlayer).volume_db	

func play(name_s: String) -> void:
	if sfx.has(name_s): (sfx[name_s] as AudioStreamPlayer).play()

# ---------- API ----------
## Crossfades from the menu theme to the race theme.
func start_music() -> void:
	_crossfade(music_player, menu_player)

## Crossfades from the race theme to the menu theme.
func play_menu_theme() -> void:
	_crossfade(menu_player, music_player)

## Crossfades between the two music players.
## If the target is already the only audible theme, no transition is needed.
## Both streams remain active during the fade so its direction can be
## reversed smoothly.
func _crossfade(to: AudioStreamPlayer, from: AudioStreamPlayer) -> void:
	if to == from:
		return
	if to.playing and not from.playing:
		return
	var target := music_base_volume_db + _volume_to_db(music_volume_percent)
	if not to.playing:
		to.volume_db = -80.0
		to.play()
	# Cancel the previous fade before starting a new one.
	# Its completion callback must not stop the newly selected theme.
	if music_fade != null and music_fade.is_valid():
		music_fade.kill()

	var from_start := from.volume_db
	var to_start := to.volume_db
	var tw := create_tween().set_parallel(true)
	music_fade = tw
	tw.tween_method(
		func(v: float) -> void:
			from.volume_db = lerpf(from_start, -80.0, v),
		0.0, 1.0, 0.9
	)
	tw.tween_method(
		func(v: float) -> void:
			to.volume_db = lerpf(to_start, target, v),
		0.0, 1.0, 0.9
	)
	# Stop the previous theme once the crossfade has completed.
	tw.chain().tween_callback(
		func() -> void:
			from.stop()
			from.volume_db = target
	)

func start_engine() -> void:
	if not engine_enabled:
		return
	engine_saw.play()
	engine_sub.play()
	engine_noise.play()
	shift_timer = 3.2

func stop_engine() -> void:
	engine_saw.stop()
	engine_sub.stop()
	engine_noise.stop()

## Enables or disables the engine hum.
## Disabling it stops all engine layers immediately.
## Enabling it does not start playback automatically.
func set_engine_enabled(on: bool) -> void:
	engine_enabled = on
	if not on:
		stop_engine()

## Adjusts the engine hum pitch according to the current race speed.
## Both oscillator layers follow the same musical pitch progression.
func set_engine_speed(kmh: float) -> void:
	var now := Time.get_ticks_msec() / 1000.0
	if now < shifting_until: return
	var scale := [110.0, 130.81, 146.83, 164.81, 174.61, 196.0, 220.0]
	var idx := mini(scale.size() - 1, int(kmh / 13.0))
	var frac := fmod(kmh, 13.0) / 13.0
	var lo: float = scale[idx]
	var hi: float = scale[mini(scale.size() - 1, idx + 1)]
	var f := lo + (hi - lo) * frac
	engine_saw.pitch_scale = f / 55.0
	engine_sub.pitch_scale = (f / 3.0) / 25.0

## Periodically dips the engine pitch to simulate gear changes.
func _process(delta: float) -> void:
	if engine_saw.playing:
		shift_timer -= delta
		if shift_timer <= 0.0:
			shift_timer = 3.2 + randf() * 4.2
			shifting_until = Time.get_ticks_msec() / 1000.0 + 0.55
			var tw := create_tween()
			var base_f := engine_saw.pitch_scale
			tw.tween_method(func(v):
					engine_saw.pitch_scale = lerpf(base_f, base_f * 0.6, v)
					engine_sub.pitch_scale = lerpf(base_f / 3.0 / 25.0, base_f * 0.6 / 3.0 / 25.0, v),
				0.0, 1.0, 0.14)
			tw.tween_interval(0.05)
			tw.tween_method(func(v):
					engine_saw.pitch_scale = lerpf(base_f * 0.6, base_f, v),
				0.0, 1.0, 0.28)

## Mutes or restores the master audio bus.
func set_muted(m: bool) -> void:
	AudioServer.set_bus_volume_db(0, -80.0 if m else 0.0)

## Converts a percentage volume setting to decibels.
## Zero percent maps to the effectively silent level.
func _volume_to_db(percent: int) -> float:
	if percent <= 0:
		return -80.0
	return linear_to_db(float(percent) / 100.0)

## Applies the selected SFX volume to engine audio and sound effects.
## Each player's configured base volume is preserved as an offset.
func set_music_volume(percent: int) -> void:
	music_volume_percent = clampi(percent, 0, 100)
	var db := music_base_volume_db + _volume_to_db(music_volume_percent)
	# both theme players share the volume; a theme that is mid-
	# crossfade gets slightly fought over by this, which the next
	# fade frame absorbs — imperceptible at these fade lengths.
	music_player.volume_db = db
	menu_player.volume_db = db


func set_sfx_volume(percent: int) -> void:
	sfx_volume_percent = clampi(percent, 0, 100)
	var adjustment := _volume_to_db(sfx_volume_percent)

	engine_saw.volume_db = float(engine_base_volumes.saw) + adjustment
	engine_sub.volume_db = float(engine_base_volumes.sub) + adjustment
	engine_noise.volume_db = float(engine_base_volumes.noise) + adjustment

	for name_s in sfx:
		var player: AudioStreamPlayer = sfx[name_s]
		player.volume_db = float(sfx_base_volumes[name_s]) + adjustment
